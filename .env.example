BOT_TOKEN=123456:telegram-bot-token
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=your_api_hash
TELEGRAM_PHONE=+79990000000
TELEGRAM_SESSION=data/telegram.session
# Directory for extra parser sessions (acc1.session, acc2.session, ...)
TELEGRAM_SESSIONS_DIR=data/sessions
# Encrypted local backup destination. Keep this directory outside normal deploy syncs.
TELEGRAM_BACKUPS_DIR=data/session-backups
# Required by `tg-active-channels-backup create|verify|restore`; do not commit it.
# SESSION_BACKUP_KEY=replace-with-a-long-unique-secret
# Idle sessions are checked without interrupting active scans.
ACCOUNT_HEALTH_CHECK_SECONDS=900
ACCOUNT_HEALTH_FAILURE_THRESHOLD=2
# Drop Telegram Desktop tdata dumps into data/tdata/<name>/ then:
#   uv run tg-active-channels-tdata
DATABASE_PATH=data/channels.sqlite3
SEARCH_LIMIT_PER_QUERY=40
HISTORY_LIMIT=40
TOP_RESULTS=10
FLOOD_SLEEP_LIMIT_SECONDS=60
# If FloodWait is longer than this, switch to another parser account instead of sleeping.
FLOOD_SWITCH_THRESHOLD_SECONDS=60
# Hard timeout for one Telegram user-API request. Timed-out requests reconnect automatically.
TELEGRAM_REQUEST_TIMEOUT_SECONDS=45
DISCOVERY_COMMENTS_PER_POST=150
DISCOVERY_PROFILE_LIMIT=1500
DISCOVERY_CANDIDATE_LIMIT=1500
DISCOVERY_GIFT_LIMIT=10

# Comma-separated Telegram user IDs of bot admins (always have access; can /allow and /disallow).
# ADMIN_USER_IDS=123456789,987654321

# Optional proxy for both Bot API (aiogram) and Telegram user API (Telethon).
# Supported: http://, https://, socks4://, socks4a://, socks5://, socks5h://
# PROXY_URL=socks5://127.0.0.1:1080

# Optional overrides if Bot API and Telethon should use different proxies.
# BOT_PROXY_URL=http://user:pass@127.0.0.1:8080
# TELEGRAM_PROXY_URL=socks5://127.0.0.1:1080
